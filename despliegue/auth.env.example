# Plantilla del archivo de entorno del microservicio de autenticación.
# En el servidor lo copio a /etc/nutrivida/auth.env, le pongo los valores reales y lo protejo:
#   sudo chown root:root /etc/nutrivida/*.env
#   sudo chmod 600 /etc/nutrivida/*.env
# Este archivo de ejemplo sí va a Git; el que tiene las claves reales nunca.

# Activa el perfil application-prod.properties, que escucha solo en 127.0.0.1.
SPRING_PROFILES_ACTIVE=prod

# Conexión a la base propia de este microservicio.
AUTH_DB_URL=jdbc:mysql://localhost:3306/nutrivida_auth
AUTH_DB_USER=nutrivida_auth_app
AUTH_DB_PASSWORD=CAMBIAR_CLAVE_AUTH

# Clave con la que firmo el token, en Base64. Tiene que ser EXACTAMENTE la misma que la del
# archivo citas.env, porque el otro microservicio verifica la firma con ella.
# La genero una sola vez en PowerShell:
#   $bytes = New-Object byte[] 32
#   [Security.Cryptography.RandomNumberGenerator]::Fill($bytes)
#   [Convert]::ToBase64String($bytes)
JWT_SECRET=CAMBIAR_SECRETO_BASE64_COMPARTIDO

# Origen exacto del frontend. Si no calza carácter por carácter, el navegador bloquea por CORS.
APP_CORS_ALLOWED_ORIGIN=http://IP_PUBLICA

# Contraseña con la que se crean las cuentas de demostración al arrancar.
# En producción conviene cambiarla y después actualizar las claves desde el panel.
APP_DATOS_INICIALES_PASSWORD=CAMBIAR_CLAVE_DEMOSTRACION
