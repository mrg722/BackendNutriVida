# Plantilla del archivo de entorno del microservicio de citas.
# En el servidor lo copio a /etc/nutrivida/citas.env, le pongo los valores reales y lo protejo
# con chmod 600. Este archivo de ejemplo sí va a Git; el que tiene las claves reales nunca.

SPRING_PROFILES_ACTIVE=prod

# Base propia de este microservicio, con su propia cuenta de MySQL.
# La clave de base de datos sí puede ser distinta a la de auth, y conviene que lo sea.
CITAS_DB_URL=jdbc:mysql://localhost:3306/nutrivida_citas
CITAS_DB_USER=nutrivida_citas_app
CITAS_DB_PASSWORD=CAMBIAR_CLAVE_CITAS

# Esta clave sí tiene que ser idéntica a la de auth.env: con ella verifico la firma del token.
# Si no coinciden, cada petición responderá 401 aunque el inicio de sesión haya funcionado.
JWT_SECRET=CAMBIAR_SECRETO_BASE64_COMPARTIDO

APP_CORS_ALLOWED_ORIGIN=http://IP_PUBLICA
