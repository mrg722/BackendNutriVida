            },
            "url": { "raw": "{{citasUrl}}/mediciones/1", "host": ["{{citasUrl}}"], "path": ["mediciones", "1"] },
            "description": "Solo el profesional que la registró, o el administrador, pueden modificarla."
          }
        },
        {
          "name": "Peso fuera de rango (400)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correoPaciente\": \"paciente@nutrivida.cl\",\n  \"fecha\": \"2026-11-17\",\n  \"pesoKg\": 500,\n  \"tallaCm\": 172\n}"
            },
            "url": { "raw": "{{citasUrl}}/mediciones", "host": ["{{citasUrl}}"], "path": ["mediciones"] },
            "description": "Prueba negativa: el peso admite de 1 a 400 kilos, para atajar errores de tipeo en la consulta."
          }
        },
        {
          "name": "Eliminar medición (204)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{citasUrl}}/mediciones/1", "host": ["{{citasUrl}}"], "path": ["mediciones", "1"] }
          }
        }
      ]
    },
    {
      "name": "Estadísticas",
      "item": [
        {
          "name": "Indicadores de la clínica (solo ADMIN)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{citasUrl}}/estadisticas", "host": ["{{citasUrl}}"], "path": ["estadisticas"] },
            "description": "Devuelve el total de citas, el desglose por estado, la tasa de inasistencia y las atenciones por profesional."
          }
        }
      ]
    }
  ]
