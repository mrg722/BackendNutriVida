          }
        }
      ]
    },
    {
      "name": "Citas",
      "item": [
        {
          "name": "Mis citas (según el rol del token)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{citasUrl}}/citas/mias", "host": ["{{citasUrl}}"], "path": ["citas", "mias"] },
            "description": "Al PACIENTE le devuelve sus citas, al NUTRICIONISTA su agenda y al ADMIN todas. La decisión la toma el servidor, no el cliente."
          }
        },
        {
          "name": "Todas las citas (solo ADMIN)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{citasUrl}}/citas", "host": ["{{citasUrl}}"], "path": ["citas"] },
            "description": "Con un token de PACIENTE responde 403."
          }
        },
        {
          "name": "Buscar cita por id",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{citasUrl}}/citas/1", "host": ["{{citasUrl}}"], "path": ["citas", "1"] },
            "description": "Solo la ve su paciente, el nutricionista de esa agenda o el administrador. Cualquier otro recibe 403."
          }
        },
        {
          "name": "Solicitar hora (201, PACIENTE)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nutricionistaId\": 1,\n  \"servicioId\": 1,\n  \"fecha\": \"2026-12-15\",\n  \"hora\": \"10:00\",\n  \"motivo\": \"Primera consulta para control de peso\"\n}"
            },
            "url": { "raw": "{{citasUrl}}/citas", "host": ["{{citasUrl}}"], "path": ["citas"] },
            "description": "El correo del paciente lo toma del token, no del cuerpo. Nace siempre en estado SOLICITADA. Repetir el horario responde 409."
          }
        },
        {
          "name": "Reprogramar cita",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nutricionistaId\": 1,\n  \"servicioId\": 1,\n  \"fecha\": \"2026-12-18\",\n  \"hora\": \"15:30\",\n  \"motivo\": \"Primera consulta para control de peso\"\n}"
            },
            "url": { "raw": "{{citasUrl}}/citas/1", "host": ["{{citasUrl}}"], "path": ["citas", "1"] },
            "description": "La cita vuelve a SOLICITADA, porque la clínica tiene que confirmar el horario nuevo."
          }
        },
        {
          "name": "Cambiar el estado de la cita",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"estado\": \"CONFIRMADA\"\n}" },
            "url": { "raw": "{{citasUrl}}/citas/1/estado", "host": ["{{citasUrl}}"], "path": ["citas", "1", "estado"] },
            "description": "Estados: SOLICITADA, CONFIRMADA, ATENDIDA, CANCELADA y NO_ASISTIO. Un PACIENTE solo puede poner CANCELADA; cualquier otro valor le responde 403. Una cita en estado final responde 409."
          }
        },
        {
          "name": "Hora fuera del horario de atención (400)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nutricionistaId\": 1,\n  \"servicioId\": 1,\n  \"fecha\": \"2026-12-20\",\n  \"hora\": \"20:00\",\n  \"motivo\": \"Consulta fuera del horario de atención\"\n}"
            },
            "url": { "raw": "{{citasUrl}}/citas", "host": ["{{citasUrl}}"], "path": ["citas"] },
            "description": "Prueba negativa. La clínica atiende de 09:00 a 18:00; fuera de ese rango es un dato inválido, por eso 400 y no 409."
          }
        },
        {
          "name": "Eliminar cita (204, solo ADMIN)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{citasUrl}}/citas/1", "host": ["{{citasUrl}}"], "path": ["citas", "1"] }
          }
        }
      ]
    },
