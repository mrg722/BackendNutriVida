              "raw": "{\n  \"codigo\": \"NUT005\",\n  \"nombre\": \"Nut. Prueba Demostración\",\n  \"correo\": \"prueba@nutrivida.cl\",\n  \"especialidad\": \"Nutrición general\",\n  \"diasAtencion\": \"Lunes a Viernes\",\n  \"horario\": \"09:00 - 18:00\",\n  \"activo\": false\n}"
            },
